<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="desktop_world">

    <!-- physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- required plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ground plane -->
    <!-- when you dont specify the pose, sdf uses the default pose -->
    <model name="ground_plane">
      <!-- static means its not movable even after collision or gravity -->
      <static>true</static> 
      <link name="link">
        <collision name="collision">
          <!-- the normal tag defines the direction the plane is facing -->
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <!-- ambient is the color under ambient lighting -->
            <!-- diffuse is the color under direct lighting -->
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- a table -->
    <!-- <model name="table">
      <static>true</static>
      <pose>0.3 0 0.35 0 0 0</pose>
      <link name="table_top">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.02</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>5.0</mass>
        </inertial>
      </link>
    </model> -->

    <!-- a small box on the table -->
    <!-- <model name="box_on_table">
      <pose>0.3 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.9 0.2 0.2 1</ambient>
            <diffuse>0.9 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000417</ixx><iyy>0.0000417</iyy><izz>0.0000417</izz>
          </inertia>
        </inertial>
      </link>
    </model> -->

  </world>
</sdf>